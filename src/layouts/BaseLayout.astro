---
import '~/styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import { defaultLocale, localeHtmlLang, type Locale } from '~/i18n/locales';

interface Props {
  locale?: Locale;
  title: string;
  description?: string;
}

const { locale = defaultLocale, title, description } = Astro.props;
const htmlLang = localeHtmlLang[locale];
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NORSE Diamond Drilling" />
    <meta property="og:locale" content={htmlLang.replace('-', '_')} />
  </head>
  <body class="min-h-dvh bg-white text-rocky">
    <slot />
  </body>
</html>
