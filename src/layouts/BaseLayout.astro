---
import '~/styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import TranslationBanner from '~/components/layout/TranslationBanner.astro';
import { defaultLocale, localeHtmlLang, type Locale } from '~/i18n/locales';

interface Props {
  locale?: Locale;
  title: string;
  description?: string;
  /** Path without locale prefix, used by LangSwitcher to build sibling URLs. */
  path?: string;
  /** Render the untranslated-fallback banner at the top of the page. */
  showTranslationBanner?: boolean;
}

const {
  locale = defaultLocale,
  title,
  description,
  path,
  showTranslationBanner = false,
} = Astro.props;

const htmlLang = localeHtmlLang[locale];
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NORSE Diamond Drilling" />
    <meta property="og:locale" content={htmlLang.replace('-', '_')} />
  </head>
  <body class="flex min-h-dvh flex-col bg-white text-rocky">
    <TranslationBanner locale={locale} show={showTranslationBanner} />
    <Header locale={locale} path={path} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
