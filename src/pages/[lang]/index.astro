---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import BrandChip from '~/components/ui/BrandChip.astro';
import { t } from '~/i18n/ui';
import type { Locale } from '~/i18n/locales';

export function getStaticPaths() {
  return [
    { params: { lang: 'sv' } },
    { params: { lang: 'no' } },
    { params: { lang: 'fi' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const strings = t(locale);

const localServices = (await getCollection('services'))
  .filter((e) => e.data.locale === locale)
  .sort((a, b) => a.data.order - b.data.order);

const headlines: Record<Locale, string> = {
  en: "Extract Earth's potential with NORSE.",
  sv: 'Frig\u00f6r jordens potential med NORSE.',
  no: 'Frigj\u00f8r jordens potensial med NORSE.',
  fi: 'Vapauta maan potentiaali NORSE:n kanssa.',
};

const intros: Record<Locale, string> = {
  en: 'Core drilling across Sweden, Norway, and Finland \u2014 surface, underground, and helicopter-portable.',
  sv: 'K\u00e4rnborrning i Sverige, Norge och Finland \u2014 yt-, underjords- och helikopterburen borrning. X Drill-tj\u00e4nsterna nedan p\u00e5 svenska; NORSE-tj\u00e4nsterna p\u00e5 engelska.',
  no: 'Kjerneboring i Sverige, Norge og Finland \u2014 overflate-, underjords- og helikopterb\u00e5ren boring. Full norsk oversettelse kommer.',
  fi: 'Ydinkairausta Ruotsissa, Norjassa ja Suomessa \u2014 pinta-, maanalainen ja helikopterikuljetettava kalusto. Suomenkielinen sis\u00e4lt\u00f6 tulossa.',
};
---

<BaseLayout
  locale={locale}
  title={`NORSE Diamond Drilling \u2014 ${locale.toUpperCase()}`}
  description="NORSE Diamond Drilling \u2014 Nordic core drilling specialists."
  path={Astro.url.pathname}
  showTranslationBanner={true}
>
  <section class="border-b border-light-grey bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
      <p class="mb-6 text-xs font-medium uppercase tracking-[0.2em] text-safety-orange">
        NORSE Diamond Drilling
      </p>
      <h1 class="max-w-4xl font-display text-4xl font-semibold leading-[1.05] md:text-6xl">
        {headlines[locale]}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-rocky-80">{intros[locale]}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="mailto:contact@norsedd.com" variant="primary">
          {strings.cta.requestQuote}
        </Button>
        <Button
          href={localServices.length > 0 ? `/${locale}/services` : '/services'}
          variant="secondary"
        >
          {strings.cta.viewServices}
        </Button>
      </div>
    </div>
  </section>

  {
    localServices.length > 0 && (
      <section class="bg-light-grey/30">
        <div class="mx-auto max-w-7xl px-6 py-16">
          <h2 class="mb-8 font-display text-3xl font-semibold md:text-4xl">
            {strings.nav.services}
          </h2>
          <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
            {localServices.map((entry) => {
              const slug = entry.id.split('/').pop();
              return (
                <li>
                  <a
                    href={`/${locale}/services/${slug}`}
                    class="group flex h-full flex-col gap-3 border border-light-grey bg-white p-6 transition hover:border-safety-orange hover:shadow-sm"
                  >
                    <BrandChip brand={entry.data.brand} />
                    <h3 class="font-display text-lg font-semibold text-rocky group-hover:text-safety-orange">
                      {entry.data.title}
                    </h3>
                    <p class="text-sm leading-relaxed text-rocky-80">{entry.data.tagline}</p>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
