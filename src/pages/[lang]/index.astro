---
import BaseLayout from '~/layouts/BaseLayout.astro';
import type { Locale } from '~/i18n/locales';

export function getStaticPaths() {
  return [
    { params: { lang: 'sv' } },
    { params: { lang: 'no' } },
    { params: { lang: 'fi' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;

const headlines: Record<Locale, string> = {
  en: "Extract Earth's Potential With NORSE.",
  sv: 'Frigör jordens potential med NORSE.',
  no: 'Frigjør jordens potensial med NORSE.',
  fi: 'Vapauta maan potentiaali NORSE:n kanssa.',
};

const blurbs: Record<Locale, string> = {
  en: 'Scaffold online. Full localized content landing in subsequent commits.',
  sv: 'Ställningen är uppe. Fullständigt svenskt innehåll kommer i senare commits.',
  no: 'Stillaset er på plass. Fullstendig norsk innhold kommer i senere commits.',
  fi: 'Runko pystyssä. Suomenkielinen sisältö tulee myöhemmissä committeissa.',
};
---

<BaseLayout
  locale={locale}
  title={`NORSE Diamond Drilling — ${locale.toUpperCase()}`}
  description="NORSE Diamond Drilling — Nordic core drilling specialists."
>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center gap-6 px-6 py-24">
    <p class="text-xs font-medium tracking-[0.2em] text-safety-orange uppercase">
      NORSE Diamond Drilling
    </p>
    <h1 class="text-display-lg font-semibold leading-[1.05]">
      {headlines[locale]}
    </h1>
    <p class="text-lg text-rocky-80">
      {blurbs[locale]}
    </p>
    <nav class="mt-4 flex gap-4 text-sm" aria-label="Language switcher">
      <a class="underline underline-offset-4 hover:text-safety-orange" href="/">English</a>
      {locale !== 'sv' && <a class="underline underline-offset-4 hover:text-safety-orange" href="/sv">Svenska</a>}
      {locale !== 'no' && <a class="underline underline-offset-4 hover:text-safety-orange" href="/no">Norsk</a>}
      {locale !== 'fi' && <a class="underline underline-offset-4 hover:text-safety-orange" href="/fi">Suomi</a>}
    </nav>
  </main>
</BaseLayout>
