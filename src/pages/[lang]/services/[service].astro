---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BrandChip from '~/components/ui/BrandChip.astro';
import Button from '~/components/ui/Button.astro';
import type { Locale } from '~/i18n/locales';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return entries
    .filter((e) => e.data.locale !== 'en')
    .map((entry) => {
      const [lang, slug] = entry.id.split('/');
      return {
        params: { lang, service: slug },
        props: { entry },
      };
    });
}

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'services'>>>[number];
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const locale = data.locale as Locale;

const slug = entry.id.split('/').pop()!;
const certs = data.certifications ?? [];
const refs = data.referenceClients ?? [];

const ctas: Partial<Record<Locale, { enquire: string; all: string }>> = {
  sv: { enquire: 'Kontakta oss', all: '\u2190 Alla tj\u00e4nster' },
};
const cta = ctas[locale] ?? { enquire: 'Enquire', all: '\u2190 All services' };
---

<BaseLayout
  locale={locale}
  title={`${data.title} \u2014 NORSE Diamond Drilling`}
  description={data.seoDescription ?? data.tagline}
  path={Astro.url.pathname}
>
  <article class="border-b border-light-grey bg-white">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <nav class="mb-6 text-sm text-rocky-50" aria-label="Breadcrumb">
        <a href={`/${locale}/services`} class="hover:text-safety-orange">
          {locale === 'sv' ? 'Tj\u00e4nster' : 'Services'}
        </a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-rocky">{data.title}</span>
      </nav>
      <div class="mb-4"><BrandChip brand={data.brand} /></div>
      <h1 class="font-display text-4xl font-semibold leading-tight md:text-5xl">
        {data.title}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-rocky-80">{data.tagline}</p>
    </div>
  </article>

  <section class="bg-white">
    <div class="prose prose-rocky mx-auto max-w-3xl px-6 py-16">
      <Content />
    </div>
  </section>

  {
    (certs.length > 0 || refs.length > 0) && (
      <section class="border-t border-light-grey bg-light-grey/30">
        <div class="mx-auto grid max-w-4xl gap-12 px-6 py-16 md:grid-cols-2">
          {certs.length > 0 && (
            <div>
              <h2 class="font-display text-xl font-semibold">
                {locale === 'sv' ? 'Certifieringar' : 'Certifications'}
              </h2>
              <ul class="mt-3 flex flex-wrap gap-2 text-sm">
                {certs.map((c) => (
                  <li class="border border-rocky/20 bg-white px-3 py-1.5 text-rocky">{c}</li>
                ))}
              </ul>
            </div>
          )}
          {refs.length > 0 && (
            <div>
              <h2 class="font-display text-xl font-semibold">
                {locale === 'sv' ? 'Referenser' : 'Reference clients'}
              </h2>
              <ul class="mt-3 flex flex-wrap gap-2 text-sm">
                {refs.map((r) => (
                  <li class="border border-rocky/20 bg-white px-3 py-1.5 text-rocky">{r}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="bg-rocky text-white">
    <div class="mx-auto max-w-4xl px-6 py-16 md:flex md:items-center md:justify-between">
      <h2 class="font-display text-2xl font-semibold md:text-3xl">{data.title}</h2>
      <div class="mt-6 flex gap-3 md:mt-0">
        <Button href="mailto:contact@norsedd.com" variant="primary">{cta.enquire}</Button>
        <Button href={`/${locale}/services`} variant="ghost">{cta.all}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
