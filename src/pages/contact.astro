---
import BaseLayout from '~/layouts/BaseLayout.astro';

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'NORSE Diamond Drilling AS',
  url: 'https://www.norsedd.com',
  email: 'contact@norsedd.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Fabriksgatan 4',
    postalCode: '939 32',
    addressLocality: 'Mal\u00e5',
    addressCountry: 'SE',
  },
  areaServed: ['SE', 'NO', 'FI'],
  sameAs: ['https://www.xdrill.se'],
};
---

<BaseLayout
  locale="en"
  title="Contact \u2014 NORSE Diamond Drilling"
  description="Get in touch with NORSE Diamond Drilling (Mal\u00e5) or X Drill AB (Blattnicksele). Email, phone, or WhatsApp."
  path={Astro.url.pathname}
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} is:inline />

  <section class="border-b border-light-grey bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-safety-orange">Contact</p>
      <h1 class="max-w-3xl font-display text-4xl font-semibold leading-tight md:text-5xl">
        Let&rsquo;s talk drilling.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-rocky-80">
        Tell us about the site, the scope, and the timeline &mdash; we&rsquo;ll come back with
        rigs, crews, and a realistic schedule.
      </p>
    </div>
  </section>

  <section class="bg-light-grey/30">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="border-l-4 border-safety-orange bg-white p-8">
          <p class="text-xs font-semibold uppercase tracking-wider text-safety-orange">
            NORSE Diamond Drilling AS
          </p>
          <address class="mt-3 not-italic text-rocky">
            <p class="text-lg font-semibold">Mal&aring; HQ</p>
            <p class="mt-1 text-sm text-rocky-80">
              Fabriksgatan 4<br />
              939 32 Mal&aring;<br />
              Sweden
            </p>
            <p class="mt-4 text-sm">
              <a href="mailto:contact@norsedd.com" class="font-medium text-rocky hover:text-safety-orange">
                contact@norsedd.com
              </a>
            </p>
          </address>
        </div>

        <div class="border-l-4 border-rocky bg-white p-8">
          <p class="text-xs font-semibold uppercase tracking-wider text-rocky-50">X Drill AB</p>
          <address class="mt-3 not-italic text-rocky">
            <p class="text-lg font-semibold">Blattnicksele</p>
            <p class="mt-1 text-sm text-rocky-80">
              Sweden<br />
              <span class="text-rocky-50">
                Full address &amp; phone land with the X&nbsp;Drill migration.
              </span>
            </p>
          </address>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="https://wa.me/46000000000"
          class="inline-flex items-center gap-2 bg-safety-orange px-5 py-3 text-sm font-semibold text-white transition hover:bg-safety-orange-80"
          rel="noopener"
        >
          WhatsApp&nbsp;&rarr;
          <span class="text-xs font-normal text-white/80">(number TBC)</span>
        </a>
        <a
          href="mailto:contact@norsedd.com"
          class="inline-flex items-center gap-2 border border-rocky px-5 py-3 text-sm font-semibold text-rocky transition hover:border-safety-orange hover:text-safety-orange"
        >
          Email us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
