---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import BrandChip from '~/components/ui/BrandChip.astro';
import { norseServices, xdrillServices } from '~/data/services';

const clients = ['Boliden', 'DMX', 'FQM', 'Rana Gruber', 'Franzefoss', 'AWER'];
---

<BaseLayout
  locale="en"
  title="NORSE Diamond Drilling \u2014 Expert diamond core drilling in the Nordics"
  description="NORSE Diamond Drilling provides expert diamond core drilling services across Sweden, Norway, and Finland \u2014 surface, underground, and helicopter-portable. Together with X Drill AB we cover the full Nordic drilling spectrum."
  path={Astro.url.pathname}
>
  <section class="border-b border-light-grey bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
      <p class="mb-6 text-xs font-medium uppercase tracking-[0.2em] text-safety-orange">
        NORSE Diamond Drilling
      </p>
      <h1 class="max-w-4xl font-display text-4xl font-semibold leading-[1.05] md:text-6xl">
        Extract Earth&rsquo;s Potential With NORSE.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-rocky-80">
        Expert diamond core drilling services in the Nordics. Surface, underground, and
        helicopter-portable &mdash; plus exploration sampling, groundwater, and wind-power
        services through our subsidiary X Drill AB.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contact" variant="primary">Enquire</Button>
        <Button href="/services" variant="secondary">View services</Button>
      </div>
    </div>
  </section>

  <section class="border-b border-light-grey bg-white">
    <div class="mx-auto max-w-7xl px-6 py-10">
      <p class="mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-rocky-50">
        Trusted by
      </p>
      <ul class="flex flex-wrap items-center gap-x-10 gap-y-4 text-rocky-80">
        {
          clients.map((c) => (
            <li class="font-display text-lg font-semibold tracking-tight text-rocky/80">
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-light-grey/30">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="mb-8 flex items-center gap-3">
        <BrandChip brand="norse" />
        <h2 class="font-display text-2xl font-semibold md:text-3xl">Diamond core drilling</h2>
      </div>
      <ul class="grid gap-4 md:grid-cols-3">
        {
          norseServices.map((svc) => (
            <li>
              <a
                href={`/services/${svc.slug}`}
                class="group flex h-full flex-col gap-3 border border-light-grey bg-white p-6 transition hover:border-safety-orange hover:shadow-sm"
              >
                <h3 class="font-display text-xl font-semibold text-rocky group-hover:text-safety-orange">
                  {svc.titleEn}
                </h3>
                <p class="text-sm leading-relaxed text-rocky-80">{svc.taglineEn}</p>
                <span class="mt-auto text-sm font-medium text-safety-orange">Learn more &rarr;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="mb-8 flex items-center gap-3">
        <BrandChip brand="xdrill" />
        <h2 class="font-display text-2xl font-semibold md:text-3xl">
          Exploration, groundwater, wind
        </h2>
      </div>
      <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {
          xdrillServices.map((svc) => (
            <li>
              <a
                href={`/services/${svc.slug}`}
                class="group flex h-full flex-col gap-3 border border-light-grey bg-white p-6 transition hover:border-safety-orange hover:shadow-sm"
              >
                <h3 class="font-display text-lg font-semibold text-rocky group-hover:text-safety-orange">
                  {svc.titleEn}
                </h3>
                <p class="text-sm leading-relaxed text-rocky-80">{svc.taglineEn}</p>
                <span class="mt-auto text-sm font-medium text-safety-orange">Learn more &rarr;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-light-grey bg-rocky text-white">
    <div class="mx-auto max-w-7xl px-6 py-16 md:grid md:grid-cols-2 md:gap-16">
      <div>
        <h2 class="font-display text-3xl font-semibold md:text-4xl">
          Let&rsquo;s talk drilling.
        </h2>
        <p class="mt-4 text-rocky-50">
          Tell us about the site and scope. We&rsquo;ll come back with rigs, crews, and a
          realistic schedule.
        </p>
      </div>
      <div class="mt-6 flex items-start gap-3 md:mt-0">
        <Button href="/contact" variant="primary">Enquire</Button>
        <Button href="/about" variant="ghost" size="md">About NORSE &rarr;</Button>
      </div>
    </div>
  </section>
</BaseLayout>
