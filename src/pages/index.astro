---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  locale="en"
  title="NORSE Diamond Drilling — Nordic core drilling specialists"
  description="NORSE Diamond Drilling delivers surface, underground, and helicopter-portable core drilling across Sweden, Norway, and Finland. Together with subsidiary X Drill AB we cover the full spectrum of Nordic drilling."
>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center gap-6 px-6 py-24">
    <p class="text-xs font-medium tracking-[0.2em] text-safety-orange uppercase">
      NORSE Diamond Drilling
    </p>
    <h1 class="text-display-lg font-semibold leading-[1.05]">
      Extract Earth&apos;s Potential With NORSE.
    </h1>
    <p class="max-w-prose text-lg text-rocky-80">
      Core drilling across Sweden, Norway, and Finland. Surface, underground, and
      helicopter-portable — plus BOT/exploration, groundwater, and wind-power services
      through our subsidiary X Drill AB.
    </p>
    <p class="text-sm text-rocky-50">
      Scaffold online. Full IA and content landing in subsequent commits.
    </p>
    <nav class="mt-4 flex gap-4 text-sm" aria-label="Language switcher">
      <a class="underline underline-offset-4 hover:text-safety-orange" href="/sv">Svenska</a>
      <a class="underline underline-offset-4 hover:text-safety-orange" href="/no">Norsk</a>
      <a class="underline underline-offset-4 hover:text-safety-orange" href="/fi">Suomi</a>
    </nav>
  </main>
</BaseLayout>
