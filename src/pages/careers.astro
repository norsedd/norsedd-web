---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
---

<BaseLayout
  locale="en"
  title="Careers \u2014 NORSE Diamond Drilling"
  description="Drill for NORSE and X Drill across the Nordics. Open positions and speculative applications."
  path={Astro.url.pathname}
>
  <section class="border-b border-light-grey bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-safety-orange">Careers</p>
      <h1 class="max-w-3xl font-display text-4xl font-semibold leading-tight md:text-5xl">
        Work with NORSE.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-rocky-80">
        We hire drillers, helpers, geologists, wind-power technicians, and support staff across
        Sweden, Norway, and Finland. Open positions and the speculative application flow land
        with the content migration.
      </p>
      <div class="mt-8">
        <Button href="mailto:contact@norsedd.com?subject=Speculative%20application" variant="primary">
          Send speculative application
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
