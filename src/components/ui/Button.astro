---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-semibold tracking-tight rounded-none transition-colors ' +
  'focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-safety-orange';

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
}[size];

const variants = {
  primary: 'bg-safety-orange text-white hover:bg-safety-orange-80',
  secondary:
    'border border-rocky text-rocky hover:bg-rocky hover:text-white',
  ghost: 'text-rocky hover:text-safety-orange',
}[variant];

const Tag = href ? 'a' : 'button';
---

<Tag class:list={[base, sizes, variants, className]} href={href} {...rest}>
  <slot />
</Tag>
