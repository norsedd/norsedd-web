---
import type { ServiceBrand } from '~/data/services';

interface Props {
  brand: ServiceBrand;
  class?: string;
}

const { brand, class: className = '' } = Astro.props;

const label = brand === 'norse' ? 'NORSE' : 'X Drill';
const tone =
  brand === 'norse'
    ? 'bg-rocky text-white'
    : 'bg-safety-orange text-white';
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-2 py-0.5 text-[0.6875rem] font-semibold uppercase tracking-wider',
    tone,
    className,
  ]}
>
  {label}
</span>
